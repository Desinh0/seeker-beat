{
  "expo": {
    "name": "Seeker Beat",
    "slug": "seeker-beat",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.seekerbeat.radio",
      "jsEngine": "jsc",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ],
        "NSLocationWhenInUseUsageDescription": "Seeker Beat needs location access to show your speed in Drive Mode."
      }
    },
    "android": {
      "jsEngine": "jsc",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0C"
      },
      "package": "com.seekerbeat.radio",
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": [
      "./withKillOnSwipe.js",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Seeker Beat to use your location for the speedometer in Drive Mode."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "react-native-google-cast"
    ],
    "extra": {
      "eas": {
        "projectId": "3eff987e-4229-4c29-a020-b753a975d5b1"
      }
    }
  }
}